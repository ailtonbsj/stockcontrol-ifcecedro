<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
	<session-factory>
		<!-- Database connection settings -->
		<property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
		<property name="hibernate.connection.url">jdbc:mysql://db:3306/stockcontrol-ifce?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;useUnicode=true&amp;characterEncoding=UTF-8</property>
		<property name="hibernate.connection.username">root</property>
		<property name="hibernate.connection.password">root</property>

		<!-- SQL dialect -->
		<property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>

		<!-- Echo all executed SQL to stdout -->
		<property name="hibernate.show_sql">true</property>
		<property name="hibernate.format_sql">false</property>

		<!-- Update the database schema on startup -->
		<property name="hibernate.hbm2ddl.auto">update</property>

		<!-- Names the annotated entity class -->
		<mapping class="br.edu.ifce.cedro.stockcontrol.model.Unidade" />
		<mapping class="br.edu.ifce.cedro.stockcontrol.model.Produto" />
		<mapping class="br.edu.ifce.cedro.stockcontrol.model.Entrada" />
		<mapping class="br.edu.ifce.cedro.stockcontrol.model.Saida" />
		<mapping class="br.edu.ifce.cedro.stockcontrol.model.Usuario" />

	</session-factory>
</hibernate-configuration>
