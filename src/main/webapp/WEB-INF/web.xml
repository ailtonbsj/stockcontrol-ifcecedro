<web-app xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
	version="3.0">

	<display-name>Controle de Estoque IFCE Cedro</display-name>

	<welcome-file-list>
		<welcome-file>unidade</welcome-file>
	</welcome-file-list>

	<!-- Sem isso cada JSP e lido com o encoding padrao do servidor e os acentos
		 dos textos das telas aparecem corrompidos no navegador. -->
	<jsp-config>
		<jsp-property-group>
			<url-pattern>*.jsp</url-pattern>
			<page-encoding>UTF-8</page-encoding>
		</jsp-property-group>
	</jsp-config>

</web-app>