<!-- Navbar -->
<nav class="main-header navbar navbar-expand navbar-white navbar-light">
    <!-- Left navbar links -->
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/" class="nav-link">Inicio</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="http://ailtonbsj.github.io" target="_blank" class="nav-link">Contato</a>
        </li>
    </ul>

    <!-- Right navbar links -->
    <ul class="navbar-nav ml-auto">
        <!-- Notifications Dropdown Menu -->
        <li class="nav-item dropdown">
            <a class="nav-link" data-toggle="dropdown" href="#">
                <i class="far fa-bell"></i>
                <c:if test="${quantidadeNotificacoes > 0}">
                    <span class="badge badge-danger navbar-badge">${quantidadeNotificacoes}</span>
                </c:if>
            </a>
            <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right">
                <span class="dropdown-item dropdown-header">${quantidadeNotificacoes} Notificações</span>
                <c:choose>
                    <c:when test="${not empty produtosAbaixoMinimo}">
                        <c:forEach items="${produtosAbaixoMinimo}" var="produto">
                            <div class="dropdown-divider"></div>
                            <a href="/produto/editar?id=${produto.id}" class="dropdown-item">
                                <i class="fas fa-boxes mr-2"></i> ${produto.nome}
                                <span class="float-right text-muted text-sm"> ${produto.quantidade} ${produto.unidade.simbolo}</span>
                            </a>
                        </c:forEach>
                    </c:when>
                    <c:otherwise>
                        <div class="dropdown-divider"></div>
                        <span class="dropdown-item text-muted">Nenhum produto abaixo do estoque mínimo</span>
                    </c:otherwise>
                </c:choose>
            </div>
        </li>
    </ul>
</nav>
<!-- /.navbar -->